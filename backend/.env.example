# Render injects PORT itself; only set it for local runs.
PORT=3001
# Comma-separated allow-list of frontend origins. `*` = one-label wildcard (Vercel previews).
#   local:      http://localhost:5173
#   production: https://your-app.vercel.app,https://*.vercel.app
CLIENT_ORIGIN=http://localhost:5173
# Seconds a dropped player keeps their seat (ms). Default 30000.
# RECONNECT_GRACE_MS=30000
